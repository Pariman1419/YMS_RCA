NODE_ENV=development
DATABASE_URL=postgresql://yms:yms_dev_password@localhost:5432/YMS_DATABASE?schema=public
# Production Compose uses distinct database roles; set real secrets before deployment.
API_DATABASE_URL=postgresql://yms_api:CHANGE_ME@postgres:5432/YMS_DATABASE?connection_limit=20&pool_timeout=10
ETL_DATABASE_URL=postgresql://yms_etl:CHANGE_ME@postgres:5432/YMS_DATABASE?connection_limit=10&pool_timeout=10
POSTGRES_USER=yms
POSTGRES_PASSWORD=yms_dev_password
POSTGRES_DB=YMS_DATABASE
REDIS_URL=redis://localhost:6379
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Development-only authentication; API refuses this in production.
AUTH_DEMO=false
NEXT_PUBLIC_AUTH_DEMO=false
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_AUDIENCE=
NEXT_PUBLIC_ENTRA_TENANT_ID=
NEXT_PUBLIC_ENTRA_CLIENT_ID=
NEXT_PUBLIC_ENTRA_SCOPE=
SOURCE_DB_1_HOST=ACTL_BASE
SOURCE_DB_1_PORT=1521
SOURCE_DB_1_SERVICE=ACTL
SOURCE_DB_1_USERNAME=
SOURCE_DB_1_PASSWORD=
SOURCE_DB_2_HOST=BSM_BASE
SOURCE_DB_2_PORT=1521
SOURCE_DB_2_SERVICE=BSM
SOURCE_DB_2_USERNAME=
SOURCE_DB_2_PASSWORD=
ORACLE_CALL_TIMEOUT_MS=30000
ORACLE_QUEUE_TIMEOUT_MS=10000
ETL_CONCURRENCY=2
AI_PROVIDER=disabled
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=llama3
AI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
TEAMS_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=
UPLOAD_DIR=./uploads

AUTH_MODE=local
BOOTSTRAP_ADMIN_PASSWORD=admin

ORACLE_TRANSPORT=jdbc
JDBC_BRIDGE_URL=http://127.0.0.1:4010
JDBC_BRIDGE_TOKEN=REPLACE_WITH_RANDOM_64_CHARACTER_SECRET

# Local YMS AI Assistance; admin selects an installed chat model in the UI.
OLLAMA_BASE_URL=http://127.0.0.1:11434
