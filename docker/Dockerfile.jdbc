FROM maven:3.9-eclipse-temurin-11 AS build
WORKDIR /build
COPY apps/jdbc/pom.xml ./pom.xml
COPY apps/jdbc/src ./src
RUN mvn -B -q package
FROM eclipse-temurin:11-jre
WORKDIR /app
COPY --from=build /build/target/jdbc-bridge-1.0.0.jar /app/bridge.jar
USER 10001:10001
EXPOSE 4010
CMD ["java","-jar","/app/bridge.jar"]
